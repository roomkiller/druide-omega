{
  "name": "IntelligentSynthesis",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle (max 1000 caract\u00e8res)"
    },
    "synthesis_type": {
      "type": "string",
      "enum": [
        "memory_consolidation",
        "knowledge_discovery",
        "pattern_analysis",
        "insight_generation"
      ],
      "description": "Type de synth\u00e8se"
    },
    "source_data": {
      "type": "object",
      "description": "Donn\u00e9es sources analys\u00e9es"
    },
    "executive_summary": {
      "type": "string",
      "description": "R\u00e9sum\u00e9 ex\u00e9cutif de l'analyse"
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string"
          },
          "importance": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          },
          "category": {
            "type": "string"
          }
        }
      },
      "description": "D\u00e9couvertes cl\u00e9s"
    },
    "patterns_discovered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "frequency": {
            "type": "number"
          },
          "significance": {
            "type": "string"
          }
        }
      },
      "description": "Patterns identifi\u00e9s"
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "expected_impact": {
            "type": "string"
          },
          "resources_needed": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          }
        }
      },
      "description": "Actions recommand\u00e9es"
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Insights g\u00e9n\u00e9r\u00e9s"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Score de confiance de la synth\u00e8se"
    },
    "metadata": {
      "type": "object",
      "description": "M\u00e9tadonn\u00e9es additionnelles"
    }
  },
  "required": [
    "synthesis_type",
    "executive_summary"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}