{
  "name": "Notification",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle (max 1000 caract\u00e8res)"
    },
    "type": {
      "type": "string",
      "enum": [
        "phase_status_changed",
        "milestone_added",
        "milestone_completed",
        "dependency_blocked"
      ],
      "description": "Type de notification"
    },
    "title": {
      "type": "string",
      "description": "Titre de la notification"
    },
    "message": {
      "type": "string",
      "description": "Message d\u00e9taill\u00e9"
    },
    "phase_id": {
      "type": "string",
      "description": "ID de la phase concern\u00e9e"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info",
      "description": "Niveau de s\u00e9v\u00e9rit\u00e9"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Notification lue"
    },
    "dismissible": {
      "type": "boolean",
      "default": true,
      "description": "Peut \u00eatre ferm\u00e9e"
    }
  },
  "required": [
    "type",
    "title",
    "message"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}