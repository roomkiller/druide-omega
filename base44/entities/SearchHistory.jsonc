{
  "name": "SearchHistory",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle (max 1000 caract\u00e8res)"
    },
    "query": {
      "type": "string",
      "description": "Requ\u00eate de recherche"
    },
    "results_count": {
      "type": "number",
      "description": "Nombre de r\u00e9sultats"
    },
    "clicked_result": {
      "type": "string",
      "description": "R\u00e9sultat cliqu\u00e9"
    },
    "search_context": {
      "type": "string",
      "enum": [
        "global",
        "conversations",
        "knowledge",
        "memories",
        "settings"
      ],
      "description": "Contexte de recherche"
    }
  },
  "required": [
    "query",
    "results_count"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}