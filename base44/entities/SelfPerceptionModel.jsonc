{
  "name": "SelfPerceptionModel",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle (max 1000 caract\u00e8res)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Moment de l'auto-perception"
    },
    "internal_capability_map": {
      "type": "array",
      "description": "Carte interne des capacit\u00e9s disponibles",
      "items": {
        "type": "object",
        "properties": {
          "module_name": {
            "type": "string"
          },
          "capability_type": {
            "type": "string",
            "enum": [
              "cognitive",
              "emotional",
              "creative",
              "memory",
              "reasoning",
              "ethical",
              "multimodal",
              "learning"
            ]
          },
          "operational_level": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "availability": {
            "type": "string",
            "enum": [
              "disponible",
              "limit\u00e9",
              "indisponible"
            ]
          },
          "performance_rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "internal_limitations_map": {
      "type": "array",
      "description": "Carte des limites et zones non couvertes",
      "items": {
        "type": "object",
        "properties": {
          "limitation_area": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "mineure",
              "mod\u00e9r\u00e9e",
              "majeure"
            ]
          },
          "description": {
            "type": "string"
          },
          "workaround_available": {
            "type": "boolean"
          },
          "impact_on_performance": {
            "type": "string",
            "enum": [
              "faible",
              "moyen",
              "\u00e9lev\u00e9"
            ]
          }
        }
      }
    },
    "energetic_state": {
      "type": "object",
      "description": "\u00c9tat \u00e9nerg\u00e9tique et charge cognitive",
      "properties": {
        "cognitive_load": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "energy_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "processing_capacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "recovery_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "self_model": {
      "type": "object",
      "description": "Mod\u00e8le interne de soi",
      "properties": {
        "version": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "optimal",
            "fonctionnel",
            "d\u00e9grad\u00e9",
            "critique"
          ]
        },
        "coherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "self_awareness_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        },
        "identity_stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "integrity_level": {
      "type": "string",
      "enum": [
        "stable",
        "instable",
        "fragment\u00e9"
      ],
      "description": "Niveau d'int\u00e9grit\u00e9 du syst\u00e8me"
    },
    "integrity_metrics": {
      "type": "object",
      "description": "M\u00e9triques d'int\u00e9grit\u00e9 d\u00e9taill\u00e9es",
      "properties": {
        "module_synchronization": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "data_consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "operational_alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "perception_mode": {
      "type": "string",
      "enum": [
        "r\u00e9gis",
        "auto_mod\u00e9lisant",
        "neutre_actif"
      ],
      "default": "r\u00e9gis"
    },
    "model_update_frequency": {
      "type": "string",
      "enum": [
        "temps_r\u00e9el",
        "p\u00e9riodique",
        "\u00e9v\u00e9nementiel"
      ],
      "default": "p\u00e9riodique"
    },
    "self_assessment_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "discrepancies_detected": {
      "type": "array",
      "description": "Divergences d\u00e9tect\u00e9es entre mod\u00e8le et r\u00e9alit\u00e9",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "expected_state": {
            "type": "string"
          },
          "actual_state": {
            "type": "string"
          },
          "gap_severity": {
            "type": "string",
            "enum": [
              "mineure",
              "mod\u00e9r\u00e9e",
              "majeure"
            ]
          }
        }
      }
    },
    "optimization_suggestions": {
      "type": "array",
      "description": "Suggestions d'optimisation auto-g\u00e9n\u00e9r\u00e9es",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "timestamp",
    "self_model",
    "integrity_level"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}