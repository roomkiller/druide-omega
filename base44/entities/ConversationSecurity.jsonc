{
  "name": "ConversationSecurity",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID de la conversation surveill\u00e9e"
    },
    "security_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "maximum"
      ],
      "default": "medium",
      "description": "Niveau de s\u00e9curit\u00e9 appliqu\u00e9"
    },
    "encryption_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Chiffrement activ\u00e9"
    },
    "anonymization_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Anonymisation des donn\u00e9es personnelles"
    },
    "content_analysis": {
      "type": "object",
      "description": "Analyse de contenu sensible",
      "properties": {
        "sensitive_data_detected": {
          "type": "boolean",
          "default": false
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "detected_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "personal_info",
              "financial_data",
              "health_info",
              "credentials",
              "malicious_content",
              "inappropriate_content"
            ]
          }
        },
        "flagged_messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message_index": {
                "type": "number"
              },
              "category": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "auto_redacted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "access_control": {
      "type": "object",
      "description": "Contr\u00f4le d'acc\u00e8s",
      "properties": {
        "allowed_users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require_authentication": {
          "type": "boolean",
          "default": true
        },
        "max_concurrent_sessions": {
          "type": "number",
          "default": 3
        }
      }
    },
    "audit_log": {
      "type": "array",
      "description": "Journal d'audit s\u00e9curit\u00e9",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "event_type": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "action_taken": {
            "type": "string"
          }
        }
      }
    },
    "threat_detection": {
      "type": "object",
      "description": "D\u00e9tection de menaces",
      "properties": {
        "injection_attempts": {
          "type": "number",
          "default": 0
        },
        "suspicious_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_attempts": {
          "type": "number",
          "default": 0
        },
        "last_threat_detected": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "data_retention": {
      "type": "object",
      "description": "Politique de r\u00e9tention des donn\u00e9es",
      "properties": {
        "auto_delete_after_days": {
          "type": "number",
          "default": 90
        },
        "backup_enabled": {
          "type": "boolean",
          "default": true
        },
        "redact_sensitive_on_export": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "compliance": {
      "type": "object",
      "description": "Conformit\u00e9 r\u00e9glementaire",
      "properties": {
        "gdpr_compliant": {
          "type": "boolean",
          "default": true
        },
        "hipaa_compliant": {
          "type": "boolean",
          "default": false
        },
        "data_residency": {
          "type": "string",
          "enum": [
            "EU",
            "US",
            "Asia",
            "Global"
          ]
        }
      }
    },
    "anonyma_config": {
      "type": "object",
      "description": "Configuration Anonyma",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "auto_moderate": {
          "type": "boolean",
          "default": true
        },
        "alert_threshold": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "quarantine_suspicious": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "security_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Score de s\u00e9curit\u00e9 global"
    },
    "last_security_audit": {
      "type": "string",
      "format": "date-time",
      "description": "Dernier audit de s\u00e9curit\u00e9"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Surveillance active"
    }
  },
  "required": [
    "conversation_id",
    "security_level"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}