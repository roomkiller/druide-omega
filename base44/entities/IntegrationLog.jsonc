{
  "name": "IntegrationLog",
  "type": "object",
  "properties": {
    "integration_id": {
      "type": "string",
      "description": "ID de l'int\u00e9gration"
    },
    "event_type": {
      "type": "string",
      "description": "Type d'\u00e9v\u00e9nement"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "retry"
      ],
      "description": "Statut de l'\u00e9v\u00e9nement"
    },
    "request_data": {
      "type": "object",
      "description": "Donn\u00e9es de requ\u00eate"
    },
    "response_data": {
      "type": "object",
      "description": "Donn\u00e9es de r\u00e9ponse"
    },
    "error_message": {
      "type": "string",
      "description": "Message d'erreur"
    },
    "duration_ms": {
      "type": "number",
      "description": "Dur\u00e9e en millisecondes"
    }
  },
  "required": [
    "integration_id",
    "event_type",
    "status"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}