{
  "name": "AIFeedback",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle (max 1000 caract\u00e8res)"
    },
    "response_id": {
      "type": "string",
      "description": "ID de la r\u00e9ponse \u00e9valu\u00e9e"
    },
    "feature_type": {
      "type": "string",
      "enum": [
        "general",
        "proactive_questions",
        "multi_step_reasoning",
        "synthesis",
        "personalization",
        "empathy"
      ],
      "description": "Type de fonctionnalit\u00e9 \u00e9valu\u00e9e"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Note de 1 \u00e0 5 \u00e9toiles"
    },
    "is_positive": {
      "type": "boolean",
      "description": "Thumbs up/down"
    },
    "feedback_text": {
      "type": "string",
      "description": "Commentaire textuel"
    },
    "context_data": {
      "type": "object",
      "description": "Donn\u00e9es contextuelles de la r\u00e9ponse"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Date du feedback"
    },
    "processed": {
      "type": "boolean",
      "default": false,
      "description": "Feedback trait\u00e9 par le syst\u00e8me d'apprentissage"
    },
    "learning_impact": {
      "type": "object",
      "description": "Impact sur l'apprentissage du syst\u00e8me",
      "properties": {
        "adjustments_made": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence_delta": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "response_id",
    "feature_type",
    "rating",
    "timestamp"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}