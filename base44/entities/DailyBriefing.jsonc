{
  "name": "DailyBriefing",
  "type": "object",
  "properties": {
    "briefing_date": {
      "type": "string",
      "format": "date",
      "description": "Date du briefing"
    },
    "title": {
      "type": "string",
      "description": "Titre du briefing"
    },
    "summary": {
      "type": "string",
      "description": "R\u00e9sum\u00e9 ex\u00e9cutif du briefing"
    },
    "emerging_trends": {
      "type": "array",
      "description": "Tendances \u00e9mergentes identifi\u00e9es",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "trend": {
            "type": "string"
          },
          "significance": {
            "type": "string"
          },
          "related_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "key_breakthroughs": {
      "type": "array",
      "description": "Avanc\u00e9es significatives",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "breakthrough": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "cross_domain_insights": {
      "type": "array",
      "description": "Insights interconnect\u00e9s entre domaines",
      "items": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "insight": {
            "type": "string"
          },
          "implications": {
            "type": "string"
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Recommandations d'actions ou d'explorations",
      "items": {
        "type": "string"
      }
    },
    "knowledge_sources_analyzed": {
      "type": "array",
      "description": "Sources de connaissances analys\u00e9es",
      "items": {
        "type": "string"
      }
    },
    "generation_type": {
      "type": "string",
      "enum": [
        "automatic",
        "manual",
        "scheduled"
      ],
      "default": "manual",
      "description": "Type de g\u00e9n\u00e9ration du briefing"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Briefing lu par l'utilisateur"
    },
    "favorited": {
      "type": "boolean",
      "default": false,
      "description": "Briefing marqu\u00e9 comme favori"
    }
  },
  "required": [
    "briefing_date",
    "title",
    "summary"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}