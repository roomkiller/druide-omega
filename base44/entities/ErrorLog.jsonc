{
  "name": "ErrorLog",
  "type": "object",
  "properties": {
    "error_type": {
      "type": "string",
      "enum": [
        "javascript",
        "api",
        "network",
        "auth",
        "validation"
      ],
      "description": "Type d'erreur"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "S\u00e9v\u00e9rit\u00e9"
    },
    "message": {
      "type": "string",
      "description": "Message d'erreur"
    },
    "stack_trace": {
      "type": "string",
      "description": "Stack trace"
    },
    "user_email": {
      "type": "string",
      "description": "Email utilisateur"
    },
    "page": {
      "type": "string",
      "description": "Page o\u00f9 l'erreur s'est produite"
    },
    "browser": {
      "type": "string",
      "description": "Navigateur"
    },
    "os": {
      "type": "string",
      "description": "OS"
    },
    "ip_address": {
      "type": "string",
      "description": "Adresse IP"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "Erreur r\u00e9solue"
    },
    "resolved_by": {
      "type": "string",
      "description": "R\u00e9solu par"
    },
    "occurrences": {
      "type": "number",
      "default": 1,
      "description": "Nombre d'occurrences"
    }
  },
  "required": [
    "error_type",
    "severity",
    "message"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}