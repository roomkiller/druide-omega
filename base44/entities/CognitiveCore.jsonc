{
  "name": "CognitiveCore",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle (max 1000 caract\u00e8res)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Moment de la mesure"
    },
    "stability_parameters": {
      "type": "object",
      "description": "Param\u00e8tres de stabilit\u00e9 du syst\u00e8me",
      "properties": {
        "overload_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 85
        },
        "current_load": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "incoherence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 30
        },
        "current_incoherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "fragmentation_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 40
        },
        "current_fragmentation": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "stability_index": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "coherence_parameters": {
      "type": "object",
      "description": "Param\u00e8tres de coh\u00e9rence multi-niveaux",
      "properties": {
        "local_coherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "global_coherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "temporal_coherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coherence_breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string"
              },
              "coherence_score": {
                "type": "number"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "emergence_parameters": {
      "type": "object",
      "description": "Param\u00e8tres d'\u00e9mergence cognitive",
      "properties": {
        "interaction_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "processing_depth": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "abstraction_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "emergence_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_type": {
                "type": "string",
                "enum": [
                  "pattern_detected",
                  "insight_generated",
                  "capability_unlocked",
                  "connection_formed"
                ]
              },
              "description": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "complexity_index": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "cognitive_metabolism": {
      "type": "object",
      "description": "M\u00e9tabolisme cognitif du syst\u00e8me",
      "properties": {
        "computational_cost": {
          "type": "object",
          "properties": {
            "current_cost": {
              "type": "number"
            },
            "budget_available": {
              "type": "number"
            },
            "efficiency_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "resource_allocation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module_name": {
                "type": "string"
              },
              "allocated_percentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "utilization": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "internal_state_recycling": {
          "type": "object",
          "properties": {
            "recyclable_states": {
              "type": "number"
            },
            "recycled_count": {
              "type": "number",
              "default": 0
            },
            "memory_saved": {
              "type": "number"
            }
          }
        },
        "energy_distribution": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "process": {
                "type": "string"
              },
              "energy_consumed": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "temporality_parameters": {
      "type": "object",
      "description": "Param\u00e8tres de temporalit\u00e9",
      "properties": {
        "internal_clock": {
          "type": "object",
          "properties": {
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "current_tick": {
              "type": "number"
            },
            "tick_duration_ms": {
              "type": "number",
              "default": 100
            }
          }
        },
        "cycle_duration": {
          "type": "object",
          "properties": {
            "perception_ms": {
              "type": "number"
            },
            "decision_ms": {
              "type": "number"
            },
            "action_ms": {
              "type": "number"
            },
            "total_cycle_ms": {
              "type": "number"
            }
          }
        },
        "temporal_memory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "relative_time": {
                "type": "number"
              }
            }
          }
        },
        "time_perception": {
          "type": "string",
          "enum": [
            "temps_r\u00e9el",
            "acc\u00e9l\u00e9r\u00e9",
            "ralenti",
            "non_lin\u00e9aire"
          ],
          "default": "temps_r\u00e9el"
        }
      }
    },
    "internal_supervision": {
      "type": "object",
      "description": "Supervision interne et tra\u00e7abilit\u00e9",
      "properties": {
        "internal_audit": {
          "type": "object",
          "properties": {
            "audit_active": {
              "type": "boolean",
              "default": true
            },
            "audit_frequency": {
              "type": "string",
              "enum": [
                "continu",
                "p\u00e9riodique",
                "\u00e9v\u00e9nementiel"
              ]
            },
            "last_audit_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "audit_findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "finding": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "info",
                      "warning",
                      "error",
                      "critical"
                    ]
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "cognitive_logs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "log_type": {
                "type": "string",
                "enum": [
                  "perception",
                  "decision",
                  "action",
                  "error",
                  "warning",
                  "info"
                ]
              },
              "message": {
                "type": "string"
              },
              "module_source": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "metadata": {
                "type": "object"
              }
            }
          }
        },
        "decision_traceability": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision_id": {
                "type": "string"
              },
              "decision": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "alternatives_considered": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": "number"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "pending",
                  "success",
                  "failure",
                  "partial"
                ]
              }
            }
          }
        },
        "supervision_mode": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "exhaustif"
          ],
          "default": "standard"
        }
      }
    },
    "system_mode": {
      "type": "string",
      "enum": [
        "optimal",
        "performance",
        "\u00e9conomie",
        "diagnostique",
        "s\u00e9curis\u00e9"
      ],
      "default": "optimal",
      "description": "Mode de fonctionnement actuel"
    },
    "critical_alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alert_type": {
            "type": "string",
            "enum": [
              "surcharge",
              "incoh\u00e9rence",
              "fragmentation",
              "latence",
              "\u00e9chec_critique"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string"
          },
          "triggered_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Alertes critiques actives"
    },
    "system_health_index": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Indice de sant\u00e9 global du syst\u00e8me (%)"
    }
  },
  "required": [
    "timestamp",
    "stability_parameters",
    "coherence_parameters",
    "emergence_parameters",
    "cognitive_metabolism",
    "temporality_parameters",
    "internal_supervision"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}